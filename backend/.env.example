# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use. "gemini-2.5-pro" (strong reasoning) or "gemini-2.5-flash" /
# "gemini-3.5-flash" (faster/cheaper) all support function calling.
# NOTE: Gemini 1.0/1.5 and 2.0 models have been retired by Google -- use 2.5+ .
GEMINI_MODEL=gemini-3.5-flash

# Path to the SQLite database file (auto-created by seed_db.py)
DATABASE_PATH=./ecommerce.db

# Comma-separated list of allowed CORS origins for the frontend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080,null
